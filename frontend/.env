# ============================================
# MALL DASHBOARD - ENVIRONMENT CONFIGURATION
# ============================================

# 🗄️ DATABASE CONFIGURATION
# -------------------------
# MySQL connection string format: mysql+pymysql://username:password@host:port/database_name
# Make sure to replace 'password' with your actual MySQL root password
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/mall_db

# Alternative: Use SQLite for testing (comment above and uncomment below)
# DATABASE_URL=sqlite:///app.db

# Database Pool Settings (for production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800


# ⚡ REDIS CONFIGURATION (Optional for Windows)
# --------------------------------------------
# For Windows, if Redis is not installed, comment this out
REDIS_URL=redis://localhost:6379/0

# Alternative: Use memory caching if Redis not available
# CACHE_TYPE=simple


# 🔐 FLASK & SECURITY CONFIGURATION
# ---------------------------------
# Set to 'development' for debugging, 'production' for deployment
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=app.py

# Change these in production! Use strong random strings
SECRET_KEY=your-super-secret-key-change-in-production-12345
JWT_SECRET_KEY=jwt-super-secret-key-change-in-production-67890

# Session configuration
SESSION_TYPE=filesystem
SESSION_PERMANENT=False
SESSION_USE_SIGNER=True
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400  # 24 hours in seconds


# 📁 APPLICATION SETTINGS
# -----------------------
# Maximum file upload size (50MB in bytes)
MAX_CONTENT_LENGTH=52428800

# Upload folder (relative path)
UPLOAD_FOLDER=uploads

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application limits
MAX_BRANDS_PER_MONTH=200
MAX_FILE_UPLOAD_SIZE=50


# 📧 EMAIL CONFIGURATION (Optional)
# ---------------------------------
# For password reset and notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=noreply@mallanalytics.com


# 🌐 CORS SETTINGS
# ----------------
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization


# 🔑 API KEYS (Add if needed)
# ----------------------------
# GOOGLE_MAPS_API_KEY=your-google-maps-key
# WEATHER_API_KEY=your-weather-api-key


# ⏱️ TIMEOUT SETTINGS
# -------------------
REQUEST_TIMEOUT=30
UPLOAD_TIMEOUT=300


# 📊 PERFORMANCE SETTINGS
# -----------------------
SQLALCHEMY_ENGINE_OPTIONS='{"pool_pre_ping": true, "pool_recycle": 3600}'
SQLALCHEMY_TRACK_MODIFICATIONS=false


# ============================================
# ⚠️ IMPORTANT NOTES:
# ============================================
# 1. Change all passwords and secret keys in production!
# 2. For Gmail, use App Password not your regular password
# 3. For Redis on Windows, you may need to install Redis or comment it out
# 4. Set FLASK_ENV=production and FLASK_DEBUG=0 in production
# ============================================